
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi pembantu untuk mengecek apakah user adalah admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Mengizinkan semua orang membaca profil pengguna untuk keperluan leaderboard global
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Pengaturan R2 hanya untuk admin
    match /settings/r2 {
      allow read, write: if isAdmin();
    }

    // Pengaturan konten publik (Terms, Privacy, Contact)
    match /settings/legal {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/contact {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Banner, Icons, Backgrounds, Badges, Others: Read publik (termasuk list), Write admin
    match /banners/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /icons/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /backgrounds/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /badges/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /others/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
