
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi pembantu untuk mengecek apakah user adalah admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Mengizinkan semua orang membaca profil pengguna untuk keperluan leaderboard global
    // Namun penulisan hanya diizinkan bagi pengguna yang terautentikasi pada dokumen mereka sendiri atau admin
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Pengaturan sistem hanya bisa diakses oleh admin
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
