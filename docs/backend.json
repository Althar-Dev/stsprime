
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Informasi profil tambahan untuk pengguna.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Nama tampilan pengguna."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email pengguna."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan akun."
        },
        "photoURL": {
          "type": "string",
          "description": "URL foto profil pengguna."
        },
        "profileBg": {
          "type": "string",
          "description": "Kelas latar belakang profil."
        },
        "nameGlow": {
          "type": "boolean",
          "description": "Apakah nama memiliki efek kilau."
        },
        "fontFamily": {
          "type": "string",
          "description": "Jenis font untuk nama."
        },
        "nameColor": {
          "type": "string",
          "description": "Warna hex atau kelas tailwind untuk nama."
        },
        "badgeId": {
          "type": "string",
          "description": "ID badge yang dipilih."
        }
      },
      "required": ["email"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dokumen profil pengguna."
    }
  }
}
